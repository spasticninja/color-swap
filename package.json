{
  "name": "color-swap",
  "version": "2.0.0",
  "description": "A simple color tile swap game built with react",
  "main": "index.js",
  "scripts": {
    "dev": "parcel src/index.html --out-dir build/debug",
    "build": "rm -f docs/src.*.js docs/src.*.js.map docs/src.*.css docs/src.*.css.map && parcel build src/index.html --out-dir docs --public-url ./",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "react",
    "typescript"
  ],
  "author": "spasticninja",
  "license": "MIT",
  "devDependencies": {
    "@csstools/normalize.css": "^11.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "classnames": "^2.3.1",
    "identity-obj-proxy": "^3.0.0",
    "javascript-color-gradient": "^1.3.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "parcel-bundler": "^1.12.5",
    "sass": "^1.34.0",
    "ts-jest": "^29.4.1"
  },
  "dependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "typescript": "^5.9.3"
  }
}
